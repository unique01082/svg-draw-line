{
  "name": "@baole-space/svg-motion",
  "version": "0.1.0",
  "description": "Framework-agnostic SVG preparation and motion primitives",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": null
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unique01082/svg-draw-line.git"
  },
  "bugs": {
    "url": "https://github.com/unique01082/svg-draw-line/issues"
  },
  "homepage": "https://github.com/unique01082/svg-draw-line#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src test vite.config.ts",
    "format": "prettier --check src/index.ts \"test/**/*.ts\" vite.config.ts eslint.config.js package.json tsconfig.json tsconfig.test.json",
    "format:write": "prettier --write src/index.ts \"test/**/*.ts\" vite.config.ts eslint.config.js package.json tsconfig.json tsconfig.test.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
