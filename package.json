{
  "name": "@baole-space/svg-motion",
  "version": "0.1.0",
  "description": "Framework-agnostic SVG preparation and motion primitives",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unique01082/svg-draw-line.git"
  },
  "bugs": {
    "url": "https://github.com/unique01082/svg-draw-line/issues"
  },
  "homepage": "https://github.com/unique01082/svg-draw-line#readme",
  "scripts": {
    "build": "vite build",
    "lint": "eslint src test scripts vite.config.ts playwright.config.ts",
    "format": "prettier --check . --ignore-unknown",
    "format:write": "prettier --write . --ignore-unknown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node-next.json",
    "verify:package": "node test/package-runtime.mjs && tsc --noEmit -p tsconfig.package.json",
    "test": "vitest run --exclude 'test/browser/**' --exclude 'examples/playground/test/**'",
    "test:browser": "playwright test",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "demo": "pnpm --dir examples/playground dev",
    "demo:build": "pnpm --dir examples/playground build",
    "demo:test": "pnpm --dir examples/playground test && pnpm --dir examples/playground test:e2e",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm test:browser && pnpm build && pnpm verify:package && pnpm test:consumer"
  },
  "dependencies": {
    "dompurify": "^3.4.13"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
