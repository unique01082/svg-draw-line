{
  "name": "@baole-space/svg-motion-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm test && pnpm build && pnpm test:e2e",
    "api:generate": "node scripts/api-snapshot.mjs --write",
    "api:check": "node scripts/api-snapshot.mjs --check",
    "scaffold:version": "node scripts/scaffold-version.mjs"
  },
  "dependencies": {
    "@baole-space/svg-motion": "0.1.0",
    "@mdx-js/react": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^29.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "typedoc": "^0.28.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
